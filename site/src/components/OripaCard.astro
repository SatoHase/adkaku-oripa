---
// 一覧の1行。サムネ無しのリスト形式。
// 行の順：サイト・商材｜特典タグ → オリパ名 → 最低保証（主役）・1口価格 → 残数（取得できた時だけ）｜送客ボタン
// 色は「緑＝最低保証」「オレンジ＝送客ボタン」の2つに絞る。
// 取得できない情報（締切・残数）は「非公開」等で埋めず、行ごと出さない。site_id・category_id が増えても定義追加なしで動くこと。
import type { OripaView } from "../lib/oripa";
import { num, jst, siteLogo } from "../lib/oripa";

interface Props {
  d: OripaView;
}
const { d } = Astro.props;
const outUrl = d.affiliate_url || d.url;
const logo = siteLogo(d.site_id);
const hasStock = d.stockLeftNum !== null;

// 締切は ends_at がある時だけ出す（無いものは口数が尽きたら終了なので、あえて表示しない）
const endsAtMs = Date.parse(d.ends_at ?? "");
const remainH = Number.isFinite(endsAtMs) ? Math.max(0, Math.floor((endsAtMs - Date.now()) / 3600000)) : null;
const remainLabel = remainH === null ? "" : remainH >= 48 ? `${Math.floor(remainH / 24)}日` : `${remainH}時間`;
const isSoon = remainH !== null && remainH < 24;
---

<article
  class:list={["orow", d.isEnded && "orow--ended"]}
  data-oripa
  data-site={d.site_id}
  data-kind={d.bonusType}
  data-gap={d.adGap}
  data-rate={d.adRate}
  data-price={d.priceNum}
  data-seen={d.checkedAt}
  data-stock={d.stockRatio ?? ""}
>
  <div class="orow__main">
    <div class="orow__head">
      <span class="orow__site">
        {
          logo ? (
            <img src={logo} alt="" width="20" height="20" loading="lazy" decoding="async" />
          ) : (
            <span class="orow__initial" aria-hidden="true">{d.siteName.slice(0, 1)}</span>
          )
        }
        <span class="orow__sitename">{d.siteName}</span>
        {d.category && <span class="orow__cat">{d.category.label}</span>}
      </span>
      <span class:list={["orow__kind", `orow__kind--${d.bonusType}`]}>{d.kind}</span>
    </div>

    <h3 class="orow__title">
      <a href={d.path}>{d.displayName}</a>
    </h3>

    <dl class="orow__figures">
      <div class="orow__fig orow__fig--guar">
        <dt>最低保証</dt>
        <dd>{num(d.guaranteeNum)}<small>円</small></dd>
      </div>
      <div class="orow__fig">
        <dt>1口</dt>
        <dd>{num(d.priceNum)}<small>円</small></dd>
      </div>
    </dl>

    {
      (hasStock || remainH !== null) && !d.isEnded && (
        <div class="orow__meta">
          {hasStock && (
            <span class:list={["orow__stock", d.isLowStock && "orow__stock--low"]}>
              残り <b>{num(d.stockLeftNum!)}</b>
              {d.stockTotalNum !== null && <>/{num(d.stockTotalNum)}</>}口
              {d.isLowStock && <em>残りわずか</em>}
            </span>
          )}
          {remainH !== null && (
            <span class:list={["orow__when", isSoon && "orow__when--soon"]} title={`${jst(d.ends_at)} まで`}>
              終了まで <b>{remainLabel}</b>
            </span>
          )}
        </div>
      )
    }
  </div>

  {
    d.isEnded ? (
      <div class="orow__closed">提供終了</div>
    ) : (
      <>
        <a class="cta orow__cta" href={outUrl} rel="sponsored nofollow noopener" target="_blank">
          {d.siteName}で見る
        </a>
        {d.impUrl && <img class="a8-imp" border="0" width="1" height="1" src={d.impUrl} alt="" />}
      </>
    )
  }
</article>
