---
// 事業者のバナー画像は転載しない方針のため、画像枠は自作イラストで埋める。
// IPのロゴ・キャラクターは使わず、トレカ共通のモチーフをカテゴリ色で塗り分ける。
// 将来 oripa.json に banner_url 列が増えたら、差し替えはこのファイル内だけで済ませること。
import type { OripaView } from "../lib/oripa";
import { num, ratePct } from "../lib/oripa";

interface Props {
  d: OripaView;
  variant?: "card" | "hero";
}
const { d, variant = "card" } = Astro.props;

// 彩度はアド額の大きさに連動（0円＝くすんだ色、+1,000円以上＝最大）
const sat = Math.round(22 + d.intensity * 32);
---

<div
  class:list={["thumb", variant === "hero" && "thumb--hero"]}
  style={`--h:${d.hue};--s:${sat}%`}
>
  <svg class="thumb__art" viewBox="0 0 160 120" aria-hidden="true">
    <g class="thumb__art-spark">
      <path d="M30 22l2.6 7 7 2.6-7 2.6-2.6 7-2.6-7-7-2.6 7-2.6z" />
      <path d="M133 30l2 5.4 5.4 2-5.4 2-2 5.4-2-5.4-5.4-2 5.4-2z" />
      <path d="M124 74l1.6 4.4 4.4 1.6-4.4 1.6-1.6 4.4-1.6-4.4-4.4-1.6 4.4-1.6z" />
    </g>
    <g class="thumb__art-cards">
      <g transform="rotate(-20 54 56)">
        <rect x="36" y="30" width="36" height="52" rx="5" />
        <rect class="win" x="41" y="35" width="26" height="26" rx="3" />
        <path class="ln" d="M41 68h26M41 74h17" />
      </g>
      <g transform="rotate(20 106 56)">
        <rect x="88" y="30" width="36" height="52" rx="5" />
        <rect class="win" x="93" y="35" width="26" height="26" rx="3" />
        <path class="ln" d="M93 68h26M93 74h17" />
      </g>
      <g>
        <rect x="62" y="22" width="36" height="52" rx="5" />
        <rect class="win" x="66" y="27" width="28" height="28" rx="3" />
        {
          d.category && (
            <g class="thumb__art-icon" transform="translate(66 27) scale(1.1667)">
              <path d={d.category.icon} />
            </g>
          )
        }
        <path class="ln" d="M67 61h26M67 67h17" />
      </g>
    </g>
  </svg>

  {d.category && <span class="thumb__cat">{d.category.label}</span>}

  <div class="thumb__band">
    <span class="thumb__band-label">アド額</span>
    <span class="thumb__band-gap">
      {d.adGap >= 0 ? "+" : "−"}{num(Math.abs(d.adGap))}<small>円</small>
    </span>
    <span class="thumb__band-rate">{ratePct(d.adRate)}</span>
  </div>
</div>
