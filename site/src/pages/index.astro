---
import Base from "../layouts/Base.astro";
import data from "../data/oripa.json";
import categories from "../data/categories.json";
import sites from "../data/sites.json";
const live = data.filter((d) => d.status !== "ended");
const ended = data.filter((d) => d.status === "ended");
// 商材ごとに分ける。categories.yml に無い category_id（空含む）は「その他」
const known = new Set(categories.map((c) => c.category_id));
const groups = [
  ...categories.map((c) => ({ ...c, items: live.filter((d) => d.category_id === c.category_id) })),
  { category_id: "", name: "その他", items: live.filter((d) => !known.has(d.category_id)) },
].filter((g) => g.items.length);
const siteName = (id) => sites[id] ?? id;
---
<Base title="アド確ネットオリパ一覧">
  <h1>開催中のアド確オリパ</h1>
  {live.length === 0 && <p>現在、掲載中のオリパはありません。</p>}
  {groups.map((g) => (
    <section>
      <h2>{g.name}</h2>
      {g.items.map((d) => (
        <div class="card">
          <a href={`/oripa/${encodeURIComponent(d.id)}/`}><b>{d.name}</b></a>
          {d.new_user_only === "TRUE" || d.new_user_only === "true" ? <span class="tag">新規登録限定</span> : null}<br />
          {siteName(d.site_id)}｜{d.price}円/口｜最低保証: {d.guarantee_text}
        </div>
      ))}
    </section>
  ))}
  {ended.length > 0 && <h2>終了したオリパ</h2>}
  {ended.map((d) => <div class="card ended">{d.name}｜{siteName(d.site_id)}｜{d.price}円/口</div>)}
</Base>
