---
import Base from "../layouts/Base.astro";
import OripaCard from "../components/OripaCard.astro";
import PrNote from "../components/PrNote.astro";
import { live, ended, siteFacets, siteHue, siteLogo, jst } from "../lib/oripa";

const facets = siteFacets(live);
const lastChecked = [...live, ...ended].map((d) => d.checkedAt).filter(Boolean).sort().at(-1) ?? "";

// 価格帯は固定のレンジ。サイトが増えても影響しない。
const PRICE_BUCKETS = [
  { key: "", label: "すべて", min: "", max: "" },
  { key: "a", label: "〜1,000円", min: "0", max: "1000" },
  { key: "b", label: "1,001〜5,000円", min: "1001", max: "5000" },
  { key: "c", label: "5,001〜10,000円", min: "5001", max: "10000" },
  { key: "d", label: "10,001円〜", min: "10001", max: "" },
];

const SORTS = [
  { key: "gap", label: "アド額が大きい順" },
  { key: "rate", label: "アド率が高い順" },
  { key: "price-asc", label: "価格が安い順" },
  { key: "price-desc", label: "価格が高い順" },
  { key: "stock", label: "残り口数が少ない順" },
  { key: "new", label: "確認が新しい順" },
];

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "開催中のアド確オリパ",
  numberOfItems: live.length,
  itemListElement: live.slice(0, 30).map((d, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(d.path, Astro.site ?? "https://adkaku-oripa.pages.dev/").href,
    name: d.displayName,
  })),
};
---

<Base
  title="アド確オリパ"
  description="ネットオリパの「アド確」（1口価格に対して事業者表記の最低保証額が同額以上）を確認できたものだけ掲載。アド額・アド率・残り口数を一覧で比較できます。"
  prNote={false}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemList)} />

  <div class="hero" slot="hero">
    <img
      src="/hero-1440.webp"
      srcset="/hero-750.webp 750w, /hero-1440.webp 1440w"
      sizes="(min-width: 720px) 720px, 100vw"
      width="2070"
      height="760"
      alt="アド確のオリパがリアルタイムでわかる"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <h1 class="visually-hidden">アド確オリパ一覧</h1>

  <div class="stack" style="--stack:18px">
    <p class="text-xs muted">事業者表記の最低保証額が1口価格以上のオリパだけを掲載しています。数値は確認時点のものです。</p>

    {
      facets.length > 0 && (
        <nav class="stack" style="--stack:8px" aria-label="サイトから探す">
          <div class="sec">
            <span class="sec__bar" aria-hidden="true" />
            <h2 class="sec__title">サイトから探す</h2>
          </div>
          <div class="tiles__scroller">
            {facets.map((f) => {
              const logo = siteLogo(f.site_id);
              return (
                <button class="tile" data-tile={f.site_id} style={`--h:${siteHue(f.site_id)}`} aria-current="false">
                  <span class="tile__mark" aria-hidden="true">
                    {logo ? (
                      <img src={logo} alt="" width="68" height="30" loading="lazy" decoding="async" />
                    ) : (
                      <span class="tile__initial">{f.label.slice(0, 2)}</span>
                    )}
                  </span>
                  <span class="tile__name">{f.label}</span>
                  <span class="tile__count">{f.count}件</span>
                </button>
              );
            })}
          </div>
        </nav>
      )
    }

    <PrNote />

    {
      live.length > 0 && (
        <div class="stack" style="--stack:10px" data-controls>
          <div class="chips">
            <button class="chip" data-openchip="sort" data-active="false">
              <span data-chiplabel="sort">アド額が大きい順</span>
              <span class="chip__caret" aria-hidden="true" />
            </button>
            <button class="chip" data-openchip="site" data-active="false">
              <span data-chiplabel="site">サイト</span>
              <span class="chip__caret" aria-hidden="true" />
            </button>
            <button class="chip" data-openchip="price" data-active="false">
              <span data-chiplabel="price">価格帯</span>
              <span class="chip__caret" aria-hidden="true" />
            </button>
          </div>

          <div class="metarow">
            <span>全 <b data-visible-count>{live.length}</b> 件</span>
            {lastChecked && <span>最終更新 <span data-time={lastChecked}>{jst(lastChecked)}</span></span>}
          </div>
        </div>
      )
    }

    <div class="grid" data-list>
      {live.map((d) => <OripaCard d={d} />)}
    </div>

    {
      live.length === 0 && (
        <div class="empty">
          現在、掲載中のアド確オリパはありません。
          <br />
          新しく確認でき次第このページに掲載します。
        </div>
      )
    }
    <div class="empty" data-empty hidden>条件に合うオリパはありません。</div>
    <button class="loadmore" type="button" data-loadmore hidden></button>

    {
      ended.length > 0 && (
        <details class="ended-toggle">
          <summary>
            <span class="sec__bar" aria-hidden="true" style="background:hsl(var(--muted-foreground))" />
            <span class="sec__title">終了したオリパ</span>
            <span class="sec__count">{ended.length}件</span>
            <span class="ended-toggle__caret" aria-hidden="true" />
          </summary>
          <div class="ended-toggle__body stack" style="--stack:10px">
            <p class="text-xs muted">提供終了を確認したものです。過去の掲載条件の参考として残しています。</p>
            <div class="grid">
              {ended.slice(0, 30).map((d) => <OripaCard d={d} />)}
            </div>
          </div>
        </details>
      )
    }
  </div>

  {
    live.length > 0 && (
      <>
        <button class="fab" data-openchip="sort" aria-label="絞り込み・並び替え">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16M7 12h10M10 18h4" />
          </svg>
          絞り込み
        </button>

        <dialog class="sheet" data-sheet>
          <form method="dialog">
            <div class="sheet__head">
              <span class="sheet__title">絞り込み・並び替え</span>
              <button class="sheet__close" value="close" type="submit">閉じる</button>
            </div>
          </form>
          <div class="sheet__body">
            <fieldset class="sheet__group" data-group="sort">
              <legend class="sheet__legend">並び替え</legend>
              <div class="opts">
                {SORTS.map((s, i) => (
                  <label class="opt">
                    <input type="radio" name="sort" value={s.key} checked={i === 0} />
                    <span>{s.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="sheet__group" data-group="site">
              <legend class="sheet__legend">サイト</legend>
              <div class="opts">
                <label class="opt">
                  <input type="radio" name="site" value="" checked />
                  <span>すべて（{live.length}）</span>
                </label>
                {facets.map((f) => (
                  <label class="opt">
                    <input type="radio" name="site" value={f.site_id} />
                    <span>{f.label}（{f.count}）</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="sheet__group" data-group="price">
              <legend class="sheet__legend">1口価格</legend>
              <div class="opts">
                {PRICE_BUCKETS.map((b, i) => (
                  <label class="opt">
                    <input type="radio" name="price" value={b.key} data-min={b.min} data-max={b.max} checked={i === 0} />
                    <span>{b.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          </div>
          <div class="sheet__foot">
            <button class="cta cta--lg" style="width:100%" type="button" data-sheet-apply>
              <b data-apply-count>{live.length}</b> 件を表示
            </button>
          </div>
        </dialog>
      </>
    )
  }
</Base>

<script>
  // 絞り込み・並び替え・ページ送り（静的HTML＋素のJSのみ。フレームワークは使わない）
  const PAGE_SIZE = 20;
  const numFmt = new Intl.NumberFormat("ja-JP");
  const list = document.querySelector<HTMLElement>("[data-list]");
  const sheet = document.querySelector<HTMLDialogElement>("[data-sheet]");

  if (list && sheet) {
    const cards = Array.from(list.querySelectorAll<HTMLElement>("[data-oripa]"));
    const emptyBox = document.querySelector<HTMLElement>("[data-empty]");
    const countEl = document.querySelector<HTMLElement>("[data-visible-count]");
    const applyCountEl = sheet.querySelector<HTMLElement>("[data-apply-count]");
    const loadMore = document.querySelector<HTMLButtonElement>("[data-loadmore]");
    const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tile]"));
    const nOf = (el: HTMLElement, key: string) => Number(el.dataset[key] ?? 0);

    const radios = (name: string) =>
      Array.from(sheet.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`));
    const checked = (name: string) => radios(name).find((r) => r.checked) ?? radios(name)[0];

    const comparators: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      gap: (a, b) => nOf(b, "gap") - nOf(a, "gap") || nOf(b, "rate") - nOf(a, "rate"),
      rate: (a, b) => nOf(b, "rate") - nOf(a, "rate") || nOf(b, "gap") - nOf(a, "gap"),
      "price-asc": (a, b) => nOf(a, "price") - nOf(b, "price"),
      "price-desc": (a, b) => nOf(b, "price") - nOf(a, "price"),
      stock: (a, b) => {
        const v = (el: HTMLElement) => (el.dataset.stock === "" ? 2 : Number(el.dataset.stock));
        return v(a) - v(b);
      },
      new: (a, b) => String(b.dataset.seen ?? "").localeCompare(String(a.dataset.seen ?? "")),
    };

    let shown = PAGE_SIZE;

    function setRadio(name: string, value: string) {
      const r = radios(name).find((x) => x.value === value);
      if (r) r.checked = true;
    }

    function matches(card: HTMLElement) {
      const site = checked("site").value;
      if (site && card.dataset.site !== site) return false;
      const p = checked("price");
      const price = nOf(card, "price");
      if (p.dataset.min && price < Number(p.dataset.min)) return false;
      if (p.dataset.max && price > Number(p.dataset.max)) return false;
      return true;
    }

    function apply(reset = true) {
      if (reset) shown = PAGE_SIZE;
      const sortKey = checked("sort").value;
      const siteKey = checked("site").value;
      const priceKey = checked("price").value;

      const matched = cards.filter(matches).sort(comparators[sortKey] ?? comparators.gap);
      for (const c of matched) list.appendChild(c);

      if (shown > matched.length) shown = Math.max(PAGE_SIZE, Math.ceil(matched.length / PAGE_SIZE) * PAGE_SIZE);
      const visible = new Set(matched.slice(0, shown));
      for (const c of cards) c.hidden = !visible.has(c);

      if (emptyBox) emptyBox.hidden = matched.length > 0;
      if (countEl) countEl.textContent = numFmt.format(matched.length);
      if (applyCountEl) applyCountEl.textContent = numFmt.format(matched.length);

      const rest = matched.length - visible.size;
      if (loadMore) {
        loadMore.hidden = rest <= 0;
        loadMore.textContent = `もっと見る（残り${numFmt.format(rest)}件）`;
      }

      const label = (name: string) => checked(name).nextElementSibling?.textContent?.trim() ?? "";
      const set = (name: string, text: string, active: boolean) => {
        const el = document.querySelector<HTMLElement>(`[data-chiplabel="${name}"]`);
        if (el) el.textContent = text;
        el?.closest<HTMLElement>(".chip")?.setAttribute("data-active", String(active));
      };
      set("sort", label("sort"), sortKey !== "gap");
      set("site", siteKey ? label("site").replace(/（.*）$/, "") : "サイト", Boolean(siteKey));
      set("price", priceKey ? label("price") : "価格帯", Boolean(priceKey));
      for (const t of tiles) t.setAttribute("aria-current", String(t.dataset.tile === siteKey));

      try {
        localStorage.setItem("ao:v2", JSON.stringify({ sortKey, siteKey, priceKey }));
      } catch {}
    }

    try {
      const saved = JSON.parse(localStorage.getItem("ao:v2") ?? "{}");
      if (saved.sortKey) setRadio("sort", saved.sortKey);
      if (saved.siteKey) setRadio("site", saved.siteKey);
      if (saved.priceKey) setRadio("price", saved.priceKey);
    } catch {}

    loadMore?.addEventListener("click", () => {
      shown += PAGE_SIZE;
      apply(false);
    });

    for (const btn of document.querySelectorAll<HTMLElement>("[data-openchip]")) {
      btn.addEventListener("click", () => {
        sheet.showModal();
        const group = sheet.querySelector<HTMLElement>(`[data-group="${btn.dataset.openchip}"]`);
        group?.scrollIntoView({ block: "nearest" });
      });
    }
    for (const r of sheet.querySelectorAll<HTMLInputElement>("input[type=radio]")) {
      r.addEventListener("change", () => apply());
    }
    sheet.querySelector("[data-sheet-apply]")?.addEventListener("click", () => sheet.close());

    // サイトタイルはシートを開かずにその場で絞り込む
    for (const t of tiles) {
      t.addEventListener("click", () => {
        const nextValue = t.getAttribute("aria-current") === "true" ? "" : (t.dataset.tile ?? "");
        setRadio("site", nextValue);
        apply();
        list.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }

    apply();
  }
</script>
