---
import Base from "../../layouts/Base.astro";
import OripaCard from "../../components/OripaCard.astro";
import { all, yen, num, ratePct, jst, siteLogo } from "../../lib/oripa";
import type { OripaView } from "../../lib/oripa";

export function getStaticPaths() {
  return all.map((d) => ({ params: { id: d.id }, props: { d } }));
}

interface Props {
  d: OripaView;
}
const { d } = Astro.props;

const related = all
  .filter((o) => o.site_id === d.site_id && o.id !== d.id && !o.isEnded)
  .sort((a, b) => b.adGap - a.adGap)
  .slice(0, 3);

const outUrl = d.affiliate_url || d.url;
const logo = siteLogo(d.site_id);
const description = `${d.siteName}の「${d.displayName}」は1口${yen(d.priceNum)}、事業者表記の最低保証${yen(d.guaranteeNum)}（差額${num(d.adGap)}円／${ratePct(d.adRate)}）。確認時点の情報です。`;

const shareUrl = new URL(d.path, Astro.site ?? "https://adkaku-oripa.pages.dev/").href;
const shareText = `【PR】${d.siteName}｜${d.displayName}\n1口${yen(d.priceNum)} / 最低保証${yen(d.guaranteeNum)}（差額${num(d.adGap)}円）\n※事業者表記に基づく確認時点の情報`;
const xHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`;
---

<Base
  title={`${d.displayName}｜${d.siteName}`}
  description={description}
    ogType="article"
>
  <div class="stack" style="--stack:16px">
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/">オリパ一覧</a>
      <span aria-hidden="true">›</span>
      <a href={`/?site=${encodeURIComponent(d.site_id)}`}>{d.siteName}</a>
    </nav>

    <section class="summary">
      <div class="summary__head">
        <span class="orow__site">
          {logo ? <img src={logo} alt="" width="20" height="20" decoding="async" /> : null}
          <span class="orow__sitename">{d.siteName}</span>
          {d.category && <span class="orow__cat">{d.category.label}</span>}
        </span>
        {d.isEnded ? (
          <span class="orow__kind">提供終了</span>
        ) : (
          <span class:list={["orow__kind", `orow__kind--${d.bonusType}`]}>{d.kind}</span>
        )}
      </div>
      <h1 class="summary__title">{d.displayName}</h1>

      <dl class="summary__figures">
        <div class="summary__fig summary__fig--guar">
          <dt>最低保証</dt>
          <dd>{num(d.guaranteeNum)}<small>円</small></dd>
        </div>
        <div class="summary__fig">
          <dt>1口価格</dt>
          <dd>{num(d.priceNum)}<small>円</small></dd>
        </div>
      </dl>

      {
        d.stockLeftNum !== null && !d.isEnded && (
          <div class:list={["orow__stock", d.isLowStock && "orow__stock--low"]}>
            残り <b>{num(d.stockLeftNum)}</b>
            {d.stockTotalNum !== null && <>/{num(d.stockTotalNum)}</>}口
            {d.isLowStock && <em>残りわずか</em>}
          </div>
        )
      }

      {
        !d.isEnded && (
          <div class="summary__cta" data-main-cta>
            <a class="cta cta--lg" href={outUrl} rel="sponsored nofollow noopener" target="_blank">
              {d.siteName}で見る
            </a>
            <p class="text-xs muted">
              {d.siteName}の公式ページが開きます{d.checkedAt && <>（<span data-time={d.checkedAt}>{jst(d.checkedAt)}</span>に確認）</>}
            </p>
          </div>
        )
      }
    </section>

    {
      d.isEnded && (
        <div class="alert">
          <div class="alert-title">このオリパは提供終了を確認しています</div>
          <p class="alert-description">
            当サイトの巡回で継続して確認できなくなったため、終了として扱っています。過去の掲載情報として残しています。
          </p>
        </div>
      )
    }

    <div class="card">
      <div class="card-header">
        <h2 class="card-title">確認した内容</h2>
      </div>
      <div class="card-content" style="padding-top:6px">
        <table class="kv">
          <tbody>
            <tr><th scope="row">1口価格</th><td>{yen(d.priceNum)}</td></tr>
            <tr><th scope="row">最低保証の表記</th><td>{d.guarantee_text || "—"}</td></tr>
            <tr><th scope="row">最低保証（円換算）</th><td>{yen(d.guaranteeNum)}</td></tr>
            {
              d.stockLeftNum !== null && (
                <tr>
                  <th scope="row">残り口数</th>
                  <td>
                    {num(d.stockLeftNum)}
                    {d.stockTotalNum !== null && <> / {num(d.stockTotalNum)}</>}
                    <span class="text-xs muted">（確認時点）</span>
                  </td>
                </tr>
              )
            }
            {d.first_seen_at && <tr><th scope="row">初回確認</th><td>{jst(d.first_seen_at)}</td></tr>}
            {d.checkedAt && <tr><th scope="row">最終確認</th><td>{jst(d.checkedAt)}</td></tr>}
          </tbody>
        </table>
      </div>
    </div>

    <div class="alert">
      <div class="alert-title">購入前にご確認ください</div>
      <p class="alert-description">
        上記は当サイトが確認した時点で事業者サイトに表記されていた内容です。価格・最低保証・在庫は事業者側の判断で変更・終了される場合があります。「アド確」は最低保証額と1口価格の比較であり、当選内容や換金額を保証するものではありません。
      </p>
    </div>

    <div class="actions">
      <a class="btn btn--outline" href="/">一覧へ戻る</a>
      <a class="btn btn--outline" href={xHref} rel="nofollow noopener" target="_blank">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.2 2.3h3.4l-7.4 8.4 8.7 11.5h-6.8l-5.3-7-6.1 7H1.3l7.9-9L.9 2.3h7l4.8 6.4zm-1.2 17.9h1.9L6.8 4.2h-2z" /></svg>
        共有
      </a>
    </div>

    {
      related.length > 0 && (
        <div class="stack" style="--stack:4px;padding-top:16px" data-related>
          <div class="sec">
            <span class="sec__bar" aria-hidden="true" />
            <h2 class="sec__title">{d.siteName}の他のアド確オリパ</h2>
            <span class="sec__count">{related.length}件</span>
          </div>
          <div class="olist">
            {related.map((r) => <OripaCard d={r} />)}
          </div>
        </div>
      )
    }
  </div>

  {
    !d.isEnded && (
      <div class="stickycta" data-stickycta hidden>
        <div class="stickycta__inner">
          <a class="cta cta--lg" href={outUrl} rel="sponsored nofollow noopener" target="_blank">
            {d.siteName}で見る
          </a>
        </div>
      </div>
    )
  }
</Base>

<script>
  // 固定CTAは「本文のボタンを通り過ぎ、関連オリパ（各行にボタンがある）に達するまで」の間だけ出す
  const main = document.querySelector("[data-main-cta]");
  const related = document.querySelector("[data-related]");
  const sticky = document.querySelector<HTMLElement>("[data-stickycta]");
  if (main && sticky && "IntersectionObserver" in window) {
    let passedMain = false;
    let reachedRelated = false;
    const update = () => (sticky.hidden = !passedMain || reachedRelated);
    new IntersectionObserver(([e]) => {
      passedMain = !e.isIntersecting && e.boundingClientRect.top < 0;
      update();
    }).observe(main);
    if (related) {
      new IntersectionObserver(([e]) => {
        reachedRelated = e.isIntersecting || e.boundingClientRect.top < 0;
        update();
      }).observe(related);
    }
  }
</script>
